# Curro — env template (no secrets committed)
# Copy to .env.local for local dev.

# Supabase (Phase 1 real backend; local JSON store used when absent)
NEXT_PUBLIC_SITE_URL=https://curro.in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (legacy anon key also accepted: NEXT_PUBLIC_SUPABASE_ANON_KEY=)
SUPABASE_SECRET_KEY=
# Postgres (server-only, never commit values). On Vercel the app derives the
# IPv4 Supavisor pooler from a db.<ref>.supabase.co URL automatically.
DATABASE_URL=
SUPABASE_DB_POOLER_URL=
SUPABASE_REGION=ap-southeast-1
# local (default) | postgres. Vercel always uses postgres.
CURRO_STORE=local
# Required in production so session cookies survive every deployment.
SESSION_SECRET=

# Search provider (Parallel). When absent, Curro uses the built-in demo adapter.
PARALLEL_API_KEY=
# Alias accepted: PARALLEL_AI_API_KEY=
PARALLEL_SEARCH_MODE=fast
RESEARCH_PROVIDER=

# Model provider (OpenRouter). When absent, Curro uses the built-in mock composer.
# Auto-detected: setting OPENROUTER_API_KEY switches generation to OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_CHEAP_MODEL=minimax/minimax-m3.1-flash:free
OPENROUTER_STRONG_MODEL=nvidia/nemotron-3.5-super-vl:free
# Paid options (not free): nex-agi/nex-n2.5-mini, nex-agi/nex-n2.5-pro
# Optional override: mock | openrouter
MODEL_PROVIDER=

# Cost rails
WORKSPACE_DAILY_CAP_USD=5
WORKSPACE_MONTHLY_CAP_USD=25
RUN_MAX_QUERIES=4
RUN_MAX_RESULTS=12
